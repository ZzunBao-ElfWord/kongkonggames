<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pwyl.modules.app.dao.UserCertificationDao">

    <select id="queryCertification" resultType="com.pwyl.modules.app.entity.UserCertification">
        select * from user_certification where 1=1
        <if test="status!=null and status!=''">
            and status=#{status}
        </if>
        <if test="name!=null and name!=''">
            and name like #{name}
        </if>
        order by create_time desc
    </select>
    <select id="queryUserCertification" resultType="com.pwyl.modules.app.entity.UserEntity">
        SELECT
        *
        FROM
        tb_user
        WHERE
        1=1
        <if test="name!=null and name !=''">
            and user_name like #{name}
        </if>
        <if test="phone!=null and phone!=''">
            and phone like #{phone}
        </if>
        and is_authentication=1
        order by create_time desc
    </select>
</mapper>