# App Store Connect API Key（不要提交到 git）
# 在 App Store Connect → 用户和访问 → 密钥 → App Store Connect API 创建，角色选「App 管理」
ASC_KEY_ID=
ASC_ISSUER_ID=
# 留空则默认读取 ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_PATH=

# 可选：Apple Developer Team ID 与 App Store Connect Team ID
APPLE_TEAM_ID=
ITC_TEAM_ID=

# 可选：指定 IPA 路径；留空则自动在 unpackage/release、build、项目根目录找最新的 .ipa
IPA_PATH=

# 设为 true 时 fastlane upload 会走 App Store 提审（默认只上传到 TestFlight）
SUBMIT_FOR_REVIEW=false
